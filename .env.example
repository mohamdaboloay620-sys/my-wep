# هذه القيم تُضاف في Vercel: Project Settings > Environment Variables
# (لا تضع قيمك الحقيقية في هذا الملف ولا ترفعها إلى GitHub)

# بيانات الدخول الأولية
APP_USER=اسم_المستخدم
APP_PASS=كلمة_مرور_قوية

# مفتاح توقيع الجلسات: نص عشوائي طويل (32 حرف أو أكثر)
SESSION_SECRET=

# مستودع البيانات الخاص على GitHub
GITHUB_TOKEN=github_pat_xxxxxxxx
GITHUB_REPO=your-username/safi-swift-data

# اختياري
GITHUB_BRANCH=main
DATA_PATH=data/swifts.json
CREDS_PATH=data/creds.json
